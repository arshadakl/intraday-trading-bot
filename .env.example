# ===================================
# ANGEL ONE SMARTAPI CREDENTIALS
# ===================================

# Your Angel One Client ID (login ID)
ANGEL_CLIENT_ID=your_client_id_here

# Your Angel One Password (trading password)
ANGEL_PASSWORD=your_password_here

# TOTP Secret (from Angel One app - for 2FA)
ANGEL_TOTP_SECRET=your_totp_secret_here

# -----------------------------------
# API KEYS (3 separate apps)
# -----------------------------------

# Trading API Key (for placing orders)
ANGEL_TRADING_API_KEY=your_trading_api_key_here

# Historical Data API Key (for fetching candle data)
ANGEL_HISTORICAL_API_KEY=your_historical_api_key_here

# Market Feeds API Key (for real-time WebSocket data)
ANGEL_MARKET_API_KEY=your_market_api_key_here

# ===================================
# BOT CONFIGURATION
# ===================================

# Trading Mode: 'paper' or 'live'
TRADING_MODE=paper

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=5000

# Set to 'true' to make dashboard accessible publicly (for cloud hosting)
DASHBOARD_PUBLIC=false

# ===================================
# AUTHENTICATION
# ===================================

# Gmail SMTP for sending OTP (use App Password, not regular password)
# Create App Password: Google Account → Security → 2FA → App passwords
AUTH_SMTP_EMAIL=your-sender@gmail.com
AUTH_SMTP_APP_PASSWORD=your-16-char-app-password

# Optional: override SMTP server/port and connection behavior (defaults work for Gmail)
# SMTP server host (default: smtp.gmail.com)
AUTH_SMTP_HOST=smtp.gmail.com
# SMTP server port (465 for SSL, 587 for STARTTLS)
AUTH_SMTP_PORT=587
# Use implicit SSL (SMTP over SSL) - true/false (default: true)
AUTH_SMTP_USE_SSL=false
# Use STARTTLS (only used when AUTH_SMTP_USE_SSL=false) - true/false (default: false)
AUTH_SMTP_USE_TLS=true
# Network timeout in seconds for SMTP operations (default: 10)
AUTH_SMTP_TIMEOUT=10

# User email (receives OTP codes)
AUTH_USER_EMAIL=your-personal@email.com

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUTH_JWT_SECRET=your-64-character-secret-key-here

# Token validity in days (default: 7)
AUTH_TOKEN_VALIDITY_DAYS=7
